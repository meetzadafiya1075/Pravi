# ==============================================================================
# GOVERNMENT INFRASTRUCTURE ASSET LIFECYCLE MANAGEMENT PLATFORM
# MERN STACK ENVIRONMENT CONFIGURATION (Vercel / Render / MongoDB Atlas)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Node.js + Express on Render / Local)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000

# MongoDB Database (MongoDB Atlas in Production / Local MongoDB in Development)
# Production on Render: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gov_infra?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/gov_infra
MONGODB_URI=mongodb://127.0.0.1:27017/gov_infra

# JWT Security
JWT_SECRET=super_secure_secret_key_minimum_32_characters_long_1234567890
JWT_REFRESH_SECRET=refresh_super_secret_jwt_key_9876543210

# Cloudinary External Persistent Object Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gov-infra-alm.vercel.app

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (React on Vercel / Local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Government Infrastructure Asset Lifecycle Management Platform"
