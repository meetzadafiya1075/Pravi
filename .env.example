# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / Local)
# ==========================================
ENVIRONMENT=development
PORT=8000

# Database (PostgreSQL)
# Production on Render: postgresql+asyncpg://user:pass@host:5432/dbname
# Local offline fallback: sqlite+aiosqlite:///./pravi_dev.db
DATABASE_URL=sqlite+aiosqlite:///./pravi_dev.db

# Redis (Render Redis / Local)
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET_KEY=super_secure_secret_key_minimum_32_characters_long_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=asset-platform-storage
S3_REGION=auto

# CORS Configuration (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,https://asset-platform.vercel.app

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel / Local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AssetFlow Enterprise"
